{
  "name": "narxi-top",
  "private": true,
  "version": "1.0.0",
  "description": "Narx.top — supermarket price comparison",
  "author": "Narx.top",
  "homepage": "https://www.narx.top",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node -e \"require('node:dns').setServers(['8.8.8.8','8.8.4.4']); import('./server/index.js')\"",
    "test": "node --test shared/core/__tests__/core.test.js shared/core/__tests__/adapters.test.js shared/core/__tests__/auth.test.js shared/core/__tests__/ingest.test.js shared/core/__tests__/plus.test.js shared/core/__tests__/nearby.test.js shared/core/__tests__/dailyPicks.test.js server/__tests__/contact.test.js server/__tests__/admin.test.js server/__tests__/adminRoutes.test.js server/__tests__/plus.test.js server/__tests__/receipts.test.js server/__tests__/descriptionTranslate.test.js server/__tests__/storage.test.js server/__tests__/chat.test.js",
    "seed": "node scripts/seed-products.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "electron:dev": "node electron/dev.cjs",
    "electron:start": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win nsis portable --x64",
    "electron:installer": "vite build && electron-builder --win nsis --x64",
    "electron:portable": "vite build && electron-builder --win portable --x64",
    "electron:dir": "vite build && electron-builder --win dir --x64",
    "electron:publish": "vite build && electron-builder --win nsis portable --x64 --publish always"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "electron-updater": "^6.3.0",
    "express": "^5.2.1",
    "framer-motion": "^12.23.0",
    "leaflet": "^1.9.4",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "top.narx.desktop",
    "productName": "Narx.top",
    "copyright": "Narx.top",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Narx.top",
      "artifactName": "Narx.top-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Narx.top-Portable-${version}.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "protocols": [
      {
        "name": "Narx.top",
        "schemes": [
          "narxtop"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
